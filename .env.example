# Admin credentials for dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# JWT signing secret (change this to a random string in production)
JWT_SECRET=livekit-agent-ui-jwt-secret-change-me

# OpenAI token endpoint - called before each agent session start
# The endpoint should return JSON: { "token": "your-openai-api-key" }
OPEN_AI_TOKEN_URL=https://your-provider.com/token

# Server port
PORT=3001
